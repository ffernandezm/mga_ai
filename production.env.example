# Copiar como .env.production y reemplazar todos los valores CHANGE_ME.
POSTGRES_DB=mga
POSTGRES_USER=mga
POSTGRES_PASSWORD='CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD'

LLM_PROVIDER=groq
GROQ_API_KEY=CHANGE_ME
GROQ_MODEL=llama-3.1-8b-instant
OPENAI_API_KEY=
# Obligatorio solo con LLM_PROVIDER=openai. Use un ID real habilitado en su cuenta.
OPENAI_MODEL=
GOOGLE_API_KEY=

# Dominio HTTPS final, sin barra al final.
PUBLIC_URL=https://mga.example.com

RAG_ENABLED=true
RAG_SOURCE_DOCUMENT=app/data/Documento_conceptual_2023.pdf
RAG_AUTO_REINDEX=false
RAG_WARMUP_ON_START=true
RAG_CHUNK_SIZE=1400
RAG_CHUNK_OVERLAP=250
RAG_TOP_K=4
RAG_MIN_SIMILARITY=0.10
RAG_MAX_CONTEXT_CHARS=7000